# Numeric GitHub workflow ID for .github/workflows/ci.yml; pin after inspecting it.
OPDS_WORKFLOW_ID=374905819
# Separate fine-grained token: repository contents/actions read only.
OPDS_GITHUB_TOKEN=REPLACE_WITH_SEPARATE_READ_TOKEN
# Same dedicated OPDS credentials for local authenticated static XML health.
OPDS_USERNAME=REPLACE_WITH_DEDICATED_USERNAME
OPDS_PASSWORD=REPLACE_WITH_DEDICATED_PASSWORD
