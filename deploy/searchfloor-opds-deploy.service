[Unit]
Description=Exact-SHA Searchfloor OPDS release check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=searchfloor-deploy
Group=searchfloor-deploy
EnvironmentFile=/etc/searchfloor-opds/deploy.env
ExecStart=/usr/bin/flock -n /var/lib/searchfloor-opds-deploy/lock /usr/bin/node /usr/local/lib/searchfloor-opds/run-deploy.mjs
TimeoutStartSec=300
UMask=0022
MemoryMax=768M
CPUQuota=100%
TasksMax=64
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# sudo is required only for the fixed helper; NoNewPrivileges would block it.
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/opt/searchfloor-opds /var/lib/searchfloor-opds-deploy /var/lib/searchfloor-opds/cache
