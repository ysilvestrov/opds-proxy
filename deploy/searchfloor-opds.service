[Unit]
Description=Private Searchfloor OPDS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=searchfloor-opds
Group=searchfloor-opds
WorkingDirectory=/opt/searchfloor-opds/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/searchfloor-opds/runtime.env
ExecStart=/usr/bin/node /opt/searchfloor-opds/current/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillSignal=SIGTERM
UMask=0077
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/searchfloor-opds/cache

[Install]
WantedBy=multi-user.target
